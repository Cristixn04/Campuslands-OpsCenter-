# ==========================================
# CAMPUSLANDS OPS - VARIABLES DE ENTORNO
# Copia este archivo como .env y coloca tus valores reales:
# cp .env.example .env
# NUNCA SUBAS EL ARCHIVO .env A GIT
# ==========================================

# Base de Datos PostgreSQL (Docker)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=campuslands_secret_2026
POSTGRES_DB=campuslands_db
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_EXTERNAL_PORT=5435

# Backend (FastAPI)
BACKEND_PORT=8000
DATABASE_URL=postgresql://postgres:campuslands_secret_2026@db:5432/campuslands_db

# IA - Google Gemini API (Requerido para Triaje Inteligente)
# Obtén tu clave en https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Frontend (Vite + React)
VITE_API_URL=http://localhost:8000/api
FRONTEND_PORT=5173

# Webhook para alertas críticas en tiempo real (Opcional - Discord o Slack)
DISCORD_WEBHOOK_URL=
